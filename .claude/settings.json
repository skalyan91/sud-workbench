{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-repo-public.sh",
            "timeout": 10,
            "statusMessage": "Checking repo-visibility guard…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rebuild-on-stop.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
