# Python environment / build output
.venv/
__pycache__/
*.pyc
build/
dist/
*.egg-info/

# macOS
.DS_Store

# `nix build`'s own output symlink (packaging/nix flake) — points into /nix/store, not source.
result
result-*

# The grew OCaml backend: a compiled, architecture-specific binary that
# tools/bundle_grew.sh reproduces, and which app/convert.py treats as an
# optional prerequisite (falling back to ~/.opam, and degrading to
# "SUD/mSUD editing only" when it is absent). Not source.
# Anchored to the repo root: an unanchored `vendor/` also matched web/js/vendor/ (item 25's harfbuzzjs,
# genuine committed source — see THIRD-PARTY-NOTICES.md) purely by sharing the directory name.
/vendor/

# Stop-hook build bookkeeping — transient, per-machine (see CLAUDE.md
# "Automatic rebuild"). The hook itself and settings.json ARE tracked.
.claude/last-build.log
.claude/build-manual.log
.claude/.last-build-stamp
.claude/.build.lock
# Real git worktrees (`git worktree list` knows them). Committing these would put a checkout of the
# repo inside the repo; they belong to whoever created them and go away with `git worktree remove`.
.claude/worktrees/

# The UD<->SUD conversion grammars: surfacesyntacticud/tools content with no declared upstream
# licence, so no longer committed here — app/grammars.py fetches it on demand (same shape as
# vendor/ above, minus the compile step). Not source.
grammars/
